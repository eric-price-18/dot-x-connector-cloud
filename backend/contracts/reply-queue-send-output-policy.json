{
  "version": 1,
  "status": "public_candidate_default_off",
  "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "endpoint": "/service/queue/mcp",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "item": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "author_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "root_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "state": {
            "enum": [
              "pending",
              "blocked",
              "approved",
              "dispatching",
              "sent",
              "unknown",
              "cancelled"
            ]
          },
          "intent_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "intent_ref": {
            "type": "string"
          },
          "receipt_ref": {
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_created_at": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
