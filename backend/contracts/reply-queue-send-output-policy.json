    "jsonrpc": "2.0",
    "id": 1,
    "result_fields": [
      "content",
      "structuredContent"
    ],
    "content": [
      {
        "type": "text",
        "text": "JSON.stringify(the identical structuredContent value)"
      }
    ],
    "structuredContent": "validate using operation schema above"
  },
  "error_envelope_schema": {
    "type": "object",
    "properties": {
      "jsonrpc": {
        "const": "2.0"
      },
      "id": {
        "type": "null"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              -32700,
              -32603,
              -32600
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "jsonrpc",
      "id",
      "error"
    ],
    "additionalProperties": false
  },
  "error_rules": {
    "http_status": "SafeError.status; unexpected exceptions are500",
    "code": "INVALID_JSON -> -32700; status>=500 -> -32603; other failures -> -32600",
    "message": "safe machine code; unexpected exception INTERNAL_ERROR",
    "structuredContent": false,
    "started_mutation": "Once request tombstone exists, even a subsequent HTTPerror does not authorize resending; exactrequest replay returns indeterminate if completion was not saved. Read item and reconcile original intent.",
    "representative_codes": {
      "400": [
        "INVALID_QUEUE_ARGUMENTS",
        "INVALID_JSON",
        "INVALID_JSON_RPC"
      ],
      "403": [
        "QUEUE_ACCOUNT_BINDING_MISMATCH",
        "QUEUE_OWNER_BINDING_MISMATCH",
        "QUEUE_OPERATION_MISMATCH",
        "QUEUE_PROOF_BINDING_MISMATCH"
      ],
      "404": [
        "QUEUE_ITEM_NOT_FOUND"
      ],
      "409": [
        "QUEUE_INTENT_MISMATCH",
        "QUEUE_INTENT_FROZEN",
        "QUEUE_PLANNED_REPLY_EXPIRED",
        "QUEUE_CLAIM_LOST",
        "QUEUE_REVISION_CONFLICT",
        "QUEUE_ITEM_NOT_MUTABLE",
        "QUEUE_APPROVAL_EXPIRED",
        "QUEUE_FRESH_MODEL_RECHECK_REQUIRED",
        "QUEUE_COMMIT_UNCERTAIN_DO_NOT_PUBLISH",
        "QUEUE_REQUEST_REPLAY_MISMATCH"
      ],
      "503": [
        "SERVICE_QUEUE_DISABLED",
        "QUEUE_RESPONSE_BOUND",
        "QUEUE_REQUEST_ACK_UNCERTAIN",
        "QUEUE_PREFLIGHT_UNCERTAIN"
      ]
    },
    "code_list_exhaustive": false
  },
  "semantics": {
    "result_at": "request-start snapshot timestamp, not a send receipt timestamp",
    "replayed": "completed replay returns persisted original payload, with only replayed changed totrue",
    "approved_revision": "next CAS expected_revision; use publish_binding verbatim with a fresh request_id",
    "approval_expires_at": "exclusive min(itemexpires,reviewed_at+60,claim_until)",
    "published_false": "does not prove no dispatch; unknown is ambiguous; consult trusted receipt",
    "receipt_dispatched": "present only on rejectedreceipt; true is terminal dispatched rejection; false is proven no dispatch, but still no automatic retry/keyrotation",
    "no_inline_readiness": true,
    "safety_fields": "New completed approve/publish/cancel outputs intentionally omit approval_required/send_authorized. They are present on indeterminate outputs and unchanged originalfive operations. published:false is not a no-dispatch proof.",
    "base_changes_since_eee": "No removed/renamed fields in original five responses. New three outputs use compact schemas here. The additive review-only operational-hold claim extension is specified in QUEUE_CLAIM_OUTPUT_EXTENSION.json; do not infer claim publication authority.",
    "scheduler": "Call readiness separately after every completed/indeterminate action; never infer scheduling from replayed result_at or successful approval.",
    "cancel": "explicit_stop records stored author opt-out only after validclaimCAS and cancels unfrozen same-authorplans; other reasons affectonlyitem.",
