          "target_id",
          "author_id",
          "root_id",
          "state",
          "intent_key",
          "intent_ref",
          "receipt_ref",
          "reason",
          "due_at",
          "source_created_at",
          "expires_at",
          "revision"
        ],
        "additionalProperties": false
      },
      "publish_binding": {
